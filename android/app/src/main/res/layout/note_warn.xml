<?xml version="1.0" encoding="utf-8"?>
<!-- 5 minutes before a timer switches the heater off: keep it warm longer (HeaterService.warnNote) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/wTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <TextView
        android:id="@+id/wText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/w10" style="@style/WarnBtn" android:text="+10 min" />
        <TextView android:id="@+id/w30" style="@style/WarnBtn" android:text="+30 min" />
        <TextView android:id="@+id/w60" style="@style/WarnBtn" android:text="+1 h" />
        <TextView android:id="@+id/wKeep" style="@style/WarnBtn" android:layout_marginEnd="0dp" android:text="Keep on" />
    </LinearLayout>
</LinearLayout>
